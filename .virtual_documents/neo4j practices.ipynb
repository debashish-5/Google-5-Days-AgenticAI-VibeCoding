def get_person(tx,name):
    result = tx.run(
        """
        MATCH(p:Person{name:$name}) return p.name as name, p.age as age
        """,
        name = name
    )
    return result


with driver.session() as session:
    record = session.execute_read(get_person,"Debashish")
    
    
    print(record)






