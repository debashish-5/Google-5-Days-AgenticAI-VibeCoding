from langchain_groq import ChatGroq
from dotenv import load_dotenv
import os


load_dotenv()


db = FAISS.from_documents(chunks,embeddings)
retriever = db.as_retriever(search_kwargs = {'k':3})


## step - 7 LLM
groq = ChatGroq(model = 'llama-3.1-8b-instant',api_key=os.getenv("GROQ_API_KEY"))


# step 8 create filter
compressor = LLMChainFilter.from_llm(groq)



from langchain_classic.retrievers import ContextualCompressionRetriever


### step, 9 comrpression Retriever
compression_retriever = ContextualCompressionRetriever(base_compressor=compressor,base_retriever=retriever)


docs = compression_retriever.invoke('what is agentic ai?')


for doc in docs:
    print('='*20)
    print(doc.page_content)








from langchain_community.vectorstores import FAISS
db = FAISS.from_documents(chunks,embeddings)
retriever = db.as_retriever(search_kwargs = {'k':20})



## step 12 immporting crossencoder
from sentence_transformers import CrossEncoder






## load reranking model
reranker = CrossEncoder("cross-encoder/ms-marco-MiniLM-L-6-v2")


query = "Explain IVF indexing in FAISS"
candidate_docs = retriever.invoke(query)
print("Candidates:",len(candidate_docs))


## 14 .create query - documents pairs
pairs = [[query,doc.page_content] for doc in candidate_docs]


##14 calculate scores 
scores = reranker.predict(pairs)


scores


## method 1 : probabilty range between 0-1 
import torch

# Convert the raw logit scores into probabilities
probabilities = torch.sigmoid(torch.tensor(scores)).tolist()
print(probabilities)


# method -2 to see the score in idea of  0 - 1

from scipy.special import expit

# Expit is the sigmoid function in scipy
probabilities = expit(scores)
print(probabilities)


ranked_docs = sorted(zip(candidate_docs,scores),key = lambda x:x[1])


## 17. select the top 5 
top_docs = ranked_docs[:5]


for rank, (doc,score) in enumerate(top_docs,start=1):
    print("="*80)
    print("Rank:",rank)
    print("Score:",float(score))
    print("Source:",doc.metadata.get('source'))
    print()
    print(doc.page_content)



