def grade_document(question,document):
    prompt = PromptTemplate.from_template(
        """
        You are a retrieval evaluator.
        Question:
        {question}

        Document:
        {document}

        Determine whether the document contain information useful for answering the question.
        return only:
        YES 
        or 
        NO
        """
    )
    chain = prompt | llm
    result = chain.invoke({'question':question,'document':document})
    return result.content.strip().upper()


