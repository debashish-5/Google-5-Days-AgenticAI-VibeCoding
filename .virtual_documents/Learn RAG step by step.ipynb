from typing import TypedDict

class SelfRAGState(TypedDict):
    question:str
    documents:list
    answer:str
    retrieval_needed:bool
    document_relevant:bool
    answer_supported:bool
    retry_count:int

    


def decide_retrieval(question):

    prompt = f"""
Determine whether this question requires
external knowledge from a knowledge base.

Question:
{question}

Return only:
RETRIEVE
or
NO_RETRIEVE
"""

    response = llm.invoke(prompt)

    return response.content.strip()


## retrieval node
def retrieve(state):
    question = state['question']
    documents = retriver.invoke(question)
    return {
        "documents":documents
    }


# evidence reflectiond
def grade_documents(state):

    question = state["question"]

    documents = state["documents"]

    relevant = []

    for doc in documents:

        prompt = f"""
Question:
{question}

Document:
{doc.page_content}

Is this document relevant to the question?

Return only:
YES
or
NO
"""

        result = llm.invoke(prompt)

        if result.content.strip() == "YES":
            relevant.append(doc)

    return {
        "documents": relevant,
        "documents_relevant": len(relevant) > 0
    }


def generate(state):
    question = state['question']
    document = state['documents']
    context = "".join(doc.page_content for doc in docs)
    prompt = f"""

    Answer the question using the context.
    
    Question:
    {question}
    
    Context:
    {context}
    
    If the context does not contain enough evidence,
    say so.
    """
    response = llm.invoke(prompt)
    return {
        "answer":response.content
    }


def grade_answer(state):

    question = state["question"]

    answer = state["answer"]

    documents = state["documents"]

    context = "\n\n".join(
        doc.page_content
        for doc in documents
    )

    prompt = f"""
Question:
{question}

Evidence:
{context}

Answer:
{answer}

Is the answer fully supported by the evidence?

Return only:
YES
or
NO
"""

    result = llm.invoke(prompt)

    supported = (
        result.content.strip() == "YES"
    )

    return {
        "answer_supported": supported
    }


# conditional routing 
def router_retrieval(state):
    if state['retrieval_needed']:
        return "retrieve"
    return "generate"
    


def router_answer(state):
    if state['answer_supported'] :
        return "end"
    if state['retry_count'] >= 2:
        return "end"
    return "regenerate"


from langgraph.graph import StateGraph, START, END


graph = StateGraph(SelfRAGState)


# 4. Graph Construction
workflow = StateGraph(SelfRAGState)

workflow.add_node("decide_retrieval", decide_retrieval)
workflow.add_node("retrieve", retrieve)
workflow.add_node("grade_documents", grade_documents)
workflow.add_node("generate", generate)
workflow.add_node("grade_answer", grade_answer)

# Connect Edges
workflow.add_edge(START, "decide_retrieval")

workflow.add_conditional_edges(
    "decide_retrieval",
    router_retrieval,
    {
        "retrieve": "retrieve",
        "generate": "generate"
    }
)

workflow.add_edge("retrieve", "grade_documents")
workflow.add_edge("grade_documents", "generate")
workflow.add_edge("generate", "grade_answer")

workflow.add_conditional_edges(
    "grade_answer",
    router_answer,
    {
        END: END,
        "generate": "generate"
    }
)

app = workflow.compile()


app





