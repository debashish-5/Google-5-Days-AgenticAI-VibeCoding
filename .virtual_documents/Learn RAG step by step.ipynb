class MultiHopState(TypedDict):
    question:str
    current_query:str
    documents:list
    hop_count:int
    final_answer:str
    
    


def generate_nex_query(orignal_question, current_evidence):
    prompt = f"""
    Original question:
    {original_question}
    
    Evidence discovered so far:
    {current_evidence}
    
    Determine what information is still missing.
    
    Generate the next search query.
    
    If enough information has been found,
    return:
    DONE
    
    Return only the query or DONE.
    """
    response = llm.invoke(prompt)
    return response.content.strip()
    
    


from langchain_classic.retrievers.document_compressors import EmbeddingsFilter
from langchain_classic.retrievers import ContextualCompressionRetriever


filterrr = EmbeddingsFilter(embeddings=embeddings,similarity_threshold=0.70)
compressor_retriever = ContextualCompressionRetriever(
    base_retriever=retriever,
    base_compressor=filterrr
)


## renranker for only more deep relateed chunks aretaken
from sentence_transformers import CrossEncoder

reranker = CrossEncoder("BAAI/bge-reranker-base")



def multi_hop(state:MultiHopState):
    current_query = state['question']
    MAX_HOP = state['hop_count']
    evidence = []
    for hop in range(MAX_HOP):
        docs = retriever.invoke(current_query)
        evidence.extend(docs)
        next_query = generate_nex_query(current_query,docs)
        if next_query is None:
            break
        current_query = next_query
    pairs = [[current_query,chunk] for chunk in evidence]
    scores = reranker.predict(pairs)
    scored_chunks = sorted(zip(scores,docs),key=lambda x: x[0],reverse = True)
    top_chunks =  [chunk for score, chunk in scored_chunks[:5]]
    
    return {
        "documents":top_chunks,
        'current_query':current_query,
    }
    
    


def final_answer(state:MultiHopState):
    documents = state['documents']
    question = state['question']
    prompt = f"""
    ##You are a Experienced Agentic Ai Engineer. 
    Complete the answer based on given context.
    <queston>
    {question}
    </question>

    <context>
    {documents}
    """
    answer = llm.invoke(prompt)
    return {
        "final_answer":answer
    }
    


from langgraph.graph import StateGraph,START,END



graph = StateGraph(MultiHopState)
graph.add_node("multihop_node",multi_hop)
graph.add_node("final_node",final_answer)

graph.add_edge(START,"multihop_node")
graph.add_edge("multihop_node","final_node")
graph.add_edge("final_node",END)


graph.compile()












