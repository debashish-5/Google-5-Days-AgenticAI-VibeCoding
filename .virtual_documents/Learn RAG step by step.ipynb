chat_history = [
    HumanMessage("Harness Engineering"),
    AIMessage(content="There is a temptation, when builders start working with AI agents, to treat the model as the system. A new model comes out, the agent gets smarter. An older model and the agent gets worse. The model becomes the explanation for everything good and bad.")
]





response = rag_chain.invoke(
    {
        'input':'What SDLC?',
        'chat_history':chat_history
        
    }
    
)
print(response['answer'])








