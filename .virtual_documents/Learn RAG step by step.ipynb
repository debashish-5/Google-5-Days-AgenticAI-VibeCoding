from langchain_groq import ChatGroq
from dotenv import load_dotenv
import os
from langchain_core.prompts import ChatPromptTemplate,MessagesPlaceholder
from langchain_classic.chains import create_history_aware_retriever,create_retrieval_chain
from langchain_classic.chains.combine_documents import create_stuff_documents_chain
from langchain_community.vectorstores import FAISS


load_dotenv()


## lets creating db
db = FAISS.from_documents(chunks,embeddings)
retriever = db.as_retriever(search_kwargs = {"k":3})


llm = ChatGroq(model="llama-3.1-8b-instant")





history_prompt = ChatPromptTemplate.from_messages(
    [
        (
            "system",
            """
            Give the chat history and the lastest user question,
            rewrite the latest question into standalone question.

            Do NOT answer the question.
            
            """
        ),
        MessagesPlaceholder("chat_history"),
        ("human",'{input}')
    ]
)

### This is the most importtant prompt in this module





history_retriever = create_history_aware_retriever(
    llm,
    retriever,
    history_prompt
    
)


#now the retriever automatically rewrite follow up questions before searcing 






answer_prompt = ChatPromptTemplate.from_messages(
    [
        ("system",
        """
        Answer using only retrieved context.
        If the answer is not present, say you don't know.

        Context:
        {context}
        """
        ),
        MessagesPlaceholder("chat_history"),
        ("human","{input}")
    ]
)





document_chain = create_stuff_documents_chain(
    llm,
    answer_prompt
)





rag_chain = create_retrieval_chain(
    history_retriever,
    document_chain
)

## Everything is now connected.





##represent previous conversation messages:
