##build our first extractor
import fitz
import pdfplumber
import os 
import json

class PDFExtractor:
    def __init__(self,pdf_path:str,output_dir:str|None = "output_made_by_practices"):
        self.pdf_path = pdf_path
        self.output_dir = output_dir
        self.pdf = fitz.open(pdf_path)
        os.makedirs(output_dir,exist_ok=True)
        os.makedirs(os.path.join(output_dir,'images'),exist_ok=True)

    def extract(self):
        document = {
            "document_id":os.path.splitext(
                os.path.basename(self.pdf_path)
            )[0],
            "filename":os.path.basename(self.pdf_path),
            "num_pages":len(self.pdf),
            'elements':[]
        }
        self.extract_text(document)
        self.extract_images(document)
        self.extract_tables(document)
        return document

    def extract_text(self,document):
        for page_number,page in enumerate(self.pdf):
            blocks = page.get_text('blocks')
            for index,block in enumerate(blocks):
                x0,y0,x1,y1,text, *_ = block
                text = text.strip()
                if not text:
                    continue
                element = {
                    "id":(
                        f"{document['document_id']}"
                        f"_p{page_number+1}"
                        f"_text{index+1}"
                    ),
                    'document_id':document['document_id'],
                    'page_number':page_number +1 ,
                    'element_type':'text',
                    'content':text,
                    'bbox':[x0,y0,x1,y1],
                    'path':None,
                    'metadata':{}
                }
                document['elements'].append(element)

    def extract_tables(self,document):
        with pdfplumber.open(self.pdf_path) as pdf:
            for page_number,page in enumerate(pdf.pages):
                tables = page.extract_table()
                for index,table in enumerate(tables):
                    if not table:
                        continue
                    headers = table[0]
                    rows = table[1:]
                    element = {
                        "id": (
                            f"{document['document_id']}"
                            f"_p{page_number + 1}"
                            f"_table{index + 1}"
                        ),
                        "document_id": document["document_id"],
                        "page_number": page_number + 1,
                        "element_type": "table",
                        "content": {
                            "columns": headers,
                            "rows": rows
                        },
                        "bbox": None,
                        "path": None,
                        "metadata": {}
                    }
    
                    document["elements"].append(element)
                        

        def save(self,document):
            output_file = os.path.join(self.output_dir,'document.json')
            with open(output_file,"w",encoding="utf-8") as f:
                json.dump(
                    document,f,indent=2,ensure_ascii=False
                )


## chunks
chunks = [
  { "id" : "chunk_001", "text" : "Python is a programming, It is world top using language in order to AI", "topic" : "Python" },
  { "id" : "chunk_002", "text" : "Langchain,Langgraph,AutoGen & CrewAI Many etc. is a framework used to build AI Application.", "topic" : "AI" },
  { "id" : "chunk_003", "text" : "Neo4j stores data as nodes and relationships in a graph.", "topic" : "Neo4j" },
  { "id" : "chunk_004", "text" : "Neo4j uses Cypher as its declarative query language to efficiently retrieve graph data.", "topic" : "Neo4j" },
  { "id" : "chunk_005", "text" : "Neo4j released GraphAware Financial Crime Intelligence to help banks detect hidden fraud networks using enterprise AI.", "topic" : "Neo4j" }
]



from sentence_transformers import SentenceTransformer

model = SentenceTransformer(
    model_name_or_path="sentence-transformers/all-MiniLM-L6-v2"
)

for chunk in chunks:
    vector = model.encode(
        chunk['text'],
        normalize_embeddings=True
    )
    chunk['embedding'] = vector.tolist()


from neo4j import GraphDatabase
URI = "bolt://localhost:7687"
AUTH = ("neo4j", "12345678")  # Replace with your actual password
driver = GraphDatabase.driver(URI, auth=AUTH)



with driver.session() as session:
    session.run("""
    CREATE VECTOR INDEX chunk_embedding_index IF NOT EXISTS
    FOR (c:Chunk) ON (c.embedding)
    OPTIONS {
      indexConfig: {
        `vector.dimensions`: 384,
        `vector.similarity_function`: 'cosine'
      }
    }
    """)
print("Vector index created successfully!")


##  use unwind for batch ingestion
def insert_chunk(tx,chunks):
    result = tx.run(
        """
        UNWIND $chunks AS item
        MERGE (c:Chunk{id:item.id}) 
        SET c.text = item.text,
        c.topic = item.topic,
        c.embedding = item.embedding
        RETURN count(c) as processed
        """,
        chunks = chunks
    )
    return result.single()['processed']




with driver.session() as session:
    count = session.execute_write(
        insert_chunk,
        chunks
    )
    print("Processed",count)


query = "Neo4j is best"

query_vector = model.encode(
    query,
    normalize_embeddings=True
).tolist()


def vector_search(tx,query_vector,top_k):
    result = tx.run(
        """
        CALL db.index.vector.queryNodes(
        'chunk_embedding_index',
        $top_k,
        $query_vector
        )
        YIELD node, score 
        RETURN 
            node.id as id,
            node.text as text,
            node.topic as topic,
            score 
        ORDER BY score DESC
        """,
        query_vector = query_vector,
        top_k = top_k
    )
    return [record.data() for record in result]



with driver.session() as session:
    result = session.execute_read(vector_search,query_vector,3)
    for item in result:
        print(item['topic'],item['score'])
        print(item['text'])





