### Using pdfplumber 


import pdfplumber


li = []
with pdfplumber.open("documents/Day_1_v3.pdf") as pdf:
    for page_number, page in enumerate(pdf.pages):
        tables = page.extract_tables()
        print(
            f"PAGE NUMBER {page_number + 1}: "
            f"{len(tables)} tables"
        )
        li.append(tables)


for item in li:
    for table in item:
        for row in table:
            print(row)



