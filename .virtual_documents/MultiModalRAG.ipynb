import fitz
import pdfplumber
import os 
import json

class PDFExtractor:
    def __init__(self,pdf_path:str,output_dir:str|None = "output"):
        self.pdf_path = pdf_path
        self.output_dir = output_dir
        self.pdf = fitz.open(pdf_path)
        os.makedirs(output_dir,exist_ok=True)
        os.makedirs(os.path.join(output_dir,"images"),exist_ok=True)

    def extract(self):
        document = {
            "document_id":os.path.splitext(
                os.path.basename(self.pdf_path)
            )[0],
            'filename':os.path.basename(self.pdf_path),
            'num_pages':len(self.pdf),
            'elements':[]
        }
        self.extract_text(document)
        self.extract_images(document)
        self.extract_tables(document)
        return document

    def extract_text(self,document):
        for page_number, page in enumerate(self.pdf):
            blocks = page.get_text('blocks')
            for index, block in enumerate(blocks):
                x0,y0,x1,y1,text,*_ = block
                text = text.strip()
                if not text:
                    continue
                element = {
                    "id":(
                        f"{document['document_id']}"
                        f"_p{page_number+1}"
                        f"_text{index+1}"
                    ),
                    'document_id':document['document_id'],
                    'page_number':page_number +1 ,
                    'element_type':'text',
                    'content':text,
                    'bbox':[x0,y0,x1,y1],
                    'path':None,
                    'metadata':{}
                }
                document['elements'].append(element)
    def extract_images(self, document):
    
        for page_number, page in enumerate(self.pdf):
    
            images = page.get_images(full=True)
    
            for index, image in enumerate(images):
    
                xref = image[0]
    
                image_data = self.pdf.extract_image(xref)
    
                image_bytes = image_data["image"]
                extension = image_data["ext"]
    
                filename = (
                    f"{document['document_id']}"
                    f"_p{page_number + 1}"
                    f"_img{index + 1}."
                    f"{extension}"
                )
    
                path = os.path.join(
                    self.output_dir,
                    "images",
                    filename
                )
    
                with open(path, "wb") as f:
                    f.write(image_bytes)

                element = {
                    "id": (
                        f"{document['document_id']}"
                        f"_p{page_number + 1}"
                        f"_img{index + 1}"
                    ),
                    "document_id": document["document_id"],
                    "page_number": page_number + 1,
                    "element_type": "image",
                    "content": None,
                    "bbox": None,
                    "path": path,
                    "metadata": {
                        "extension": extension,
                        "xref": xref
                    }
                }
    
                document["elements"].append(element)
    def extract_tables(self, document):
    
        with pdfplumber.open(self.pdf_path) as pdf:
    
            for page_number, page in enumerate(pdf.pages):
    
                tables = page.extract_tables()
    
                for index, table in enumerate(tables):
    
                    if not table:
                        continue
    
                    headers = table[0]
                    rows = table[1:]
    
                    element = {
                        "id": (
                            f"{document['document_id']}"
                            f"_p{page_number + 1}"
                            f"_table{index + 1}"
                        ),
                        "document_id": document["document_id"],
                        "page_number": page_number + 1,
                        "element_type": "table",
                        "content": {
                            "columns": headers,
                            "rows": rows
                        },
                        "bbox": None,
                        "path": None,
                        "metadata": {}
                    }
    
                    document["elements"].append(element)

    def save(self,document):
        output_file = os.path.join(self.output_dir,'document.json')
        with open(output_file,"w",encoding="utf-8") as f:
            json.dump(
                document,
                f,
                indent=2,
                ensure_ascii=False
            )
            print(f"Saved extracted document to{output_file}")


