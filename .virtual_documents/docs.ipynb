

















from langchain_community.document_loaders import PyPDFDirectoryLoader
docs = PyPDFDirectoryLoader("documents/")


from langchain_community.embeddings import HuggingFaceEmbeddings
embeddings = HuggingFaceEmbeddings(model_name = 'sentence-transformers/all-MiniLM-L6-v2')


docs


documents = docs.load()


from langchain_text_splitters import RecursiveCharacterTextSplitter


splitter = RecursiveCharacterTextSplitter(chunk_size = 1000,chunk_overlap= 200)


texts = docs.load_and_split(splitter)


chunks = splitter.split_documents(documents)





api_key = "pcsk_3Z18nd_New68WcRtj3Uybw1EaFKUvrPfg8Tp2AtbcD8Gdovfv6kPsnM7kkzJqt1Dqdaec8"


from pinecone import Pinecone
import os
os.environ['PINECONE_API_KEY'] = api_key


vector_store = PineconeVectorStore.from_documents(documents=texts,embedding=embeddings,index_name = "google-5days-vibecoding")








# 1. Perform a test query
query = "What is the main topic of my documents?"
results = vector_store.similarity_search(query, k=2)

# 2. Print results to verify
for i, doc in enumerate(results):
    print(f"--- Result {i+1} ---")
    print(f"Content: {doc.page_content}")
    print(f"Metadata: {doc.metadata}")








text_content = [doc.page_content for doc in chunks]
vectors = embeddings.embed_documents(text_content)







import numpy as np
vectors = np.array(vectors).astype("float32")





import faiss
dimension = vectors.shape[1]


vectors.shape[1]


index = faiss.IndexHNSWFlat(
    dimension,
    32
)





index.add(vectors)
#now you are using HNSW





from langchain_community.docstore.in_memory import InMemoryDocstore


docstore = InMemoryDocstore()
index_to_docs_store_id = {}
for i, doc in enumerate(chunks):
    doc_id = str(i)
    docstore.add(
        {
            doc_id:doc
        }
    )
    index_to_docs_store_id[i] = doc_id





from langchain_community.vectorstores import FAISS



vectorstore = FAISS(
    embedding_function=embeddings,
    index=index,
    docstore=docstore,
    index_to_docstore_id=index_to_docs_store_id
)





retriever = vectorstore.as_retriever(
    search_kwargs = {
        "k":3
    }
)





docs = retriever.invoke(
    "what is vibecoding"
)


for doc in docs:
    print(doc.page_content)





vectorstore.save_local("HNSW_faiss")



