#extracting text 
text = [doc.page_content for doc in chunks]


# embedding it 
vector = embeddings.embed_documents(text)


## creating vector into numpy vector 
import numpy as np
vector = np.array(vector).astype('float32')


#taking dimension
dimension = vector.shape[1]


dimension


#LETS WE ARE TAKING 16 CLOUSTER
nlist = 3


## lets taking nbits (each group has 256)
nbiits = 8



import faiss


#create quantizer
quantizer = faiss.IndexFlatL2(dimension)


#create IVF
index = faiss.IndexIVFFlat(
    quantizer,
    dimension,
    nlist
)


# train
index.train(vector)


# adding vectors (text embeddings)
index.add(vector)


